# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- required ---
DISCORD_TOKEN=
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# --- e-mail (key delivery, password resets) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- remote slot host (optional, used by the reseller cog to restart workers) ---
VPS_HOST=
VPS_USER=root
VPS_PASS=

# --- branding ---
BRAND_NAME=CommendBot
BRAND_URL=https://example.com
BRAND_DISCORD_URL=https://example.com/discord
BRAND_RULES_URL=https://example.com/rules
BRAND_LOGO_URL=
BRAND_FOOTER_IMAGE=
BRAND_STEAM_GROUP_URL=https://steamcommunity.com/groups/csgo-commend-bot
BRAND_FOOTER=powered by CommendBot
BRAND_COLOR=708290

# --- game server customers connect to ---
GAME_SERVER_HOST=cs2.example.com
GAME_SERVER_PORT=27015

# --- guilds ---
SUPPORT_GUILD_ID=
SLOT_GUILD_ID=
COMMUNITY_GUILD_ID=
PARTNER_GUILD_ID=
LEGACY_GUILD_ID=
TESTING_GUILD_IDS=
CUSTOM_WELCOME_GUILD_IDS=
RESET_WARNING_SLOT_ID=3

# --- channels ---
